# dependencies
node_modules/

# Skills live in .claude/skills/ and are committed so a fresh clone has them.

# Python bytecode
__pycache__/
*.pyc

# runtime output
exports/
*.log
*.bak

# local secrets & env
.env
.env.local

# OS noise
Thumbs.db
.DS_Store

# database backups contain real data; only the schema travels with the repo
backup/*
!backup/schema_*.sql
!backup/README.md

# generated summary PDFs
Ringkasan_*.pdf

# InDesign sources (.indd) and preview PDFs are working files, not build inputs:
# the exporters only read the .idml plus Document fonts/ and Links/.
templates/*/*.indd
templates/*/*.pdf
