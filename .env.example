# Contoh konfigurasi server. Salin ke .env untuk lokal, atau set sebagai
# environment variable di platform (Docker/Compose/Render/Fly/systemd).

# --- wajib ---------------------------------------------------------------
# Postgres: Supabase pooler port 6543 untuk serverless; server sendiri boleh 5432.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Kunci HMAC cookie sesi. Tanpa ini kunci diacak tiap start -> semua user logout.
SESSION_SECRET=ganti-dengan-string-acak-panjang

# --- akun ----------------------------------------------------------------
# Kosong = sandi bawaan (admin123/user123/rekon123). Wajib diisi di server.
LOGIN_ADMIN_PASSWORD=
LOGIN_USER_PASSWORD=
LOGIN_REKON_PASSWORD=

# --- HTTP ----------------------------------------------------------------
PORT=8080
# Setel 1 kalau aplikasi di belakang HTTPS (reverse proxy/CDN). Cookie sesi
# hanya dikirim lewat TLS. Jangan set 1 kalau masih http:// biasa.
COOKIE_SECURE=

# --- ekspor dokumen ------------------------------------------------------
# Default: server memanggil export_bridge.py sendiri (butuh python + requirements).
# Isi EXPORT_SERVICE_URL kalau ekspor dijalankan sebagai sidecar terpisah.
EXPORT_SERVICE_URL=
PYTHON_BIN=
# Setel 1 untuk mematikan seluruh ekspor dokumen (mis. image tanpa Python).
DISABLE_EXPORTS=
EXPORT_TIMEOUT_MS=

# --- narasi AI (opsional) ------------------------------------------------
GEMINI_API_KEYS=
OPENROUTER_API_KEY=
